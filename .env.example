# Local XAMPP only. Railway injects the MYSQL* variables as references.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Separate schema for Daycare, TKIT, SDIT, and SMPIT.
UNIT_DB_NAME=school_units_portal

APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
# APP_UPLOAD_ROOT is optional locally. Railway uses /data/uploads.
APP_UPLOAD_ROOT=

# Wajib diisi pada production. Password demo lokal tidak pernah diaktifkan di production.
PORTAL_ADMIN_PASSWORD=
PORTAL_HUMAS_PASSWORD=
PORTAL_KASIR_PASSWORD=
UNIT_SUPERADMIN_PASSWORD=
UNIT_DAYCARE_ADMIN_PASSWORD=
UNIT_TKIT_ADMIN_PASSWORD=
UNIT_SDIT_ADMIN_PASSWORD=
UNIT_SMPIT_ADMIN_PASSWORD=
